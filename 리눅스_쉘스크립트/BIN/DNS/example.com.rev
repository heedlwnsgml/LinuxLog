$TTL 4
@       IN SOA  ns1.DOMAIN. root.DOMAIN. (
                                        10      ; serial
                                        1D      ; refresh
                                        1H      ; retry
                                        1W      ; expire
                                        3H )    ; minimum

;; DNS Server
                IN  NS          ns1.DOMAIN.
LASTIP          IN  PTR         ns1.DOMAIN.
